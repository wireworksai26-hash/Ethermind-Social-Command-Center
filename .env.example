# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ethermind
# Optional locally (cache and queue are skipped without it). Required on Railway.
REDIS_URL=redis://localhost:6379

# --- Auth (Better-Auth) ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# --- Token vault (AES-256-GCM): 32 bytes as 64 hex chars ---
# openssl rand -hex 32
TOKEN_VAULT_MASTER_KEY=

# --- First Super Admin ---
SEED_SUPER_ADMIN_EMAIL=kiyamtoru02@gmail.com
# Optional. If set, the seed creates the account. If empty, the Super Admin
# claims the account at /accept-invite using the email above.
SEED_SUPER_ADMIN_PASSWORD=

# --- Meta Graph API (live adapter for Klozer IG and FB) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# --- Alerts (stub in v1.0) ---
ENABLE_EXTERNAL_ALERTS=false
